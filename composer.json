{
    "name": "laravel/laravel",
    "type": "project",
    "description": "mercurio-cms",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Serg28/livewire.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Serg28/scout-elasticsearch-driver.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Serg28/commentify.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "akaunting/laravel-firewall": "^2.1",
        "arturishe21/laravel-liqpay": "^1.0",
        "babenkoivan/scout-elasticsearch-driver": "dev-dev",
        "biscolab/laravel-recaptcha": "^5.0",
        "bschmitt/laravel-amqp": "^2.0",
        "bumbummen99/shoppingcart": "^4.0",
        "daaner/turbosms": "^1.35",
        "danharrin/livewire-rate-limiting": "^1.3",
        "dedoc/scramble": "^0.8.5",
        "doctrine/dbal": "^3.7",
        "dymantic/laravel-instagram-feed": "^3.2.0",
        "elasticsearch/elasticsearch": "^7.7",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "hammerstone/fast-paginate": "^1.0",
        "huy-nguyen/laravel-optimize-init-db-connection": "^1.0",
        "iksaku/laravel-mass-update": "^1.0",
        "jorenvanhocht/laravel-share": "^4.0",
        "kwn/number-to-words": "^2.2",
        "laravel/framework": "^9.19",
        "laravel/horizon": "^5.26",
        "laravel/sanctum": "^3.0",
        "laravel/socialite": "^5.2",
        "laravel/tinker": "^2.7",
        "livewire/livewire": "^3",
        "maatwebsite/excel": "^3.1",
        "maksa988/laravel-wayforpay": "dev-master",
        "marcin-orlowski/laravel-api-response-builder": "^9.4",
        "opis/closure": "^3.6",
        "plakidan/monobank-pay": "^0.2.0",
        "predis/predis": "^1.1",
        "psr/simple-cache": "^2.0",
        "ralphjsmit/laravel-horizon-cron-supervisor": "^1.3",
        "rodenastyle/stream-parser": "^1.4",
        "rtconner/laravel-likeable": "~3.0",
        "serg28/laravel-self-diagnosis": "dev-master",
        "serg28/livewire-access": "dev-master",
        "spatie/laravel-db-snapshots": "^2.5",
        "spatie/once": "^3.1",
        "tinymce/tinymce": "^6.5",
        "usamamuneerchaudhary/commentify": "dev-main",
        "vis/artur_image_storage_l5": "2.*",
        "vis/builder_lara_5": "5.01",
        "vis/full_cache": "1.*",
        "vis/redirectmap": "1.*",
        "vxm/laravel-async": "^3.0",
        "wire-elements/modal": "^2.0"
    },
    "require-dev": {
        "mbezhanov/faker-provider-collection": "^2.0",
        "barryvdh/laravel-ide-helper": "^2.6",
        "beyondcode/laravel-query-detector": "^1.7",
        "fakerphp/faker": "^1.9.1",
        "jetbrains/phpstorm-attributes": "^1.0",
        "laravel/envoy": "^2.7",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.1",
        "nunomaduro/larastan": "^1.0",
        "nunomaduro/phpinsights": "^2.0",
        "phpunit/phpunit": "^9.5.10",
        "slevomat/coding-standard": "^7.2",
        "spatie/laravel-ignition": "^1.0",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeders",
            "database/factories"
        ],
        "files": [
            "app/Helpers/Helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan vendor:publish --tag=public --force --provider=\"Vis\\Builder\\BuilderServiceProvider\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
